{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheris.local/schemas/aetheris-event-v1.schema.json",
  "title": "AetherisEvent v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id", "schema_version", "event_type", "tenant_id", "subject_id",
    "device_id", "project_id", "session_id", "correlation_id", "source",
    "source_version", "occurred_at", "ingested_at", "payload", "content_hash",
    "redaction_report", "processing_grants"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "const": 1},
    "event_type": {
      "type": "string",
      "minLength": 1,
      "description": "Includes ide.file_opened, ide.file_edited, ide.file_saved, ide.file_closed, ide.workspace_changed and ide.extension_changed."
    },
    "tenant_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "device_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"},
    "content_refs": {"type": "array"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "redaction_report": {"type": "object"},
    "processing_grants": {"type": "array", "items": {"type": "string"}},
    "crypto_mode": {"type": "string"},
    "work_role": {
      "type": "object",
      "properties": {
        "role_id": {"type": "string"},
        "code": {"type": "string"},
        "version": {"type": "integer"},
        "source": {"type": "string"}
      }
    }
  }
}
