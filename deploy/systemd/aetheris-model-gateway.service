[Unit]
Description=Aetheris Python Model Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aetheris
Group=aetheris
WorkingDirectory=/opt/aetheris/model-gateway
EnvironmentFile=/opt/aetheris/config/model-gateway.env
ExecStart=/usr/bin/python3 -m aetheris_model_gateway
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target

