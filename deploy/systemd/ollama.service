[Unit]
Description=Aetheris Ollama 模型服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ollama
Group=ollama
SupplementaryGroups=aetheris
ExecStart=/usr/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/opt/aetheris/models/ollama
Environment=HOME=/opt/aetheris/models/ollama
Environment=OLLAMA_CONTEXT_LENGTH=16384
Environment=OLLAMA_MAX_LOADED_MODELS=2
Environment=OLLAMA_GENERATION_MODEL=qwen3:1.7b
Environment=OLLAMA_EMBEDDING_MODEL=embeddinggemma
Restart=always
RestartSec=3
ExecStartPost=/opt/aetheris/bin/pull-models.sh
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aetheris/models/ollama

[Install]
WantedBy=multi-user.target
